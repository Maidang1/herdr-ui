# Design exports. These are regenerable renders of docs.pen/01.pen and are
# far too large for the repository; the .pen source is tracked instead.
/design/

# Autosave and backup copies of the .pen source.
/docs.pen/*.autosave.pen
/docs.pen/*.bak.*

# The builds of the mygo toolchain. The manifest, mygo.json, is tracked;
# the app bundles it makes are not.
/.mygo/dev/
/.mygo/build/

# OS and editor noise.
.DS_Store
*.swp
.idea/
.vscode/

# Local secrets.
.env
.env.*
