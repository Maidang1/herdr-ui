        {
          "type": "text",
          "id": "LAC7u",
          "x": 40,
          "y": 1666,
          "name": "DM Footer Note",
          "fill": "$dark-text-tertiary",
          "textGrowth": "fixed-width",
          "width": 1360,
          "content": "审计口径：暗色 35 张画板逐节点按 .pen 实际 alpha 在根画板渐变上合成后计算 WCAG 相对亮度。正文对比度全部 ≥ 4.5:1，徽标白字 5.08:1，成功徽标 5.04:1，开关滑块 3.64:1 / 5.59:1；0 处低于阈值。",
          "fontFamily": "$font-ui",
          "fontSize": 11,
          "fontWeight": "normal"
        }
      ]
    }
  ],
